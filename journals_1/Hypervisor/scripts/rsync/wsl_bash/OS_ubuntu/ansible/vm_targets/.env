# ========== 基本系統 ==========
# SIEM/集中日誌伺服器設定
SIEM_HOST=10.0.0.10
SIEM_PORT=514

# VM 允許的埠口
ALLOWED_PORTS=22,443
CUSTOM_APP_PORTS= #8443,9200   # 若無可留空

# SSH 白名單帳號（用空白分隔）
ALLOWED_USERS="sshadmin"

# ========== 帳號與密碼/MFA ==========
MIN_PASSWORD_LENGTH=12
LOCKOUT_ATTEMPTS=5
ENABLE_MFA=true
SSH_AUTH_METHODS="publickey,keyboard-interactive"
SSH_PERMIT_ROOT_LOGIN=no
SSH_PASSWORD_AUTH=no

# ========== 系統硬體/存取 ==========
ENFORCE_USB_BLOCK=true
REQUIRE_ENCRYPTED_ROOT=true   # 要求偵測到 LUKS/加密磁碟，否則 fail

# ========== 安全服務開關 ==========
ENABLE_IDS_FAIL2BAN=true
ENABLE_MALWARE_PROTECTION=true
ENABLE_UNATTENDED_UPDATES=true
ENABLE_AUDITD=true
ENABLE_RSYSLOG_FORWARD=true
