#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
UTILS_PATH="$SCRIPT_DIR/../lib/ssh_utils.sh"
source "$UTILS_PATH"

# 參數檢查
if [ "$#" -lt 2 ]; then
    echo "⚠️ 使用方式: $0 user@host key_name [password] [key_dir] [config_path]"
    exit 1
fi

USER_HOST=$1   # "mobagel@192.168.16.62"
KEY_NAME=$2    # "mbvm250603"
PASSWORD=$3    # "密碼，可選"
RAW_KEY_DIR=$4 # "mobagel/dev_cluster"，可選

# ===== 檢查並安裝 sshpass =====
check_install_sshpass || exit 1

# ===== 設定目錄與檔案 =====
IFS=':' read -r KEY_DIR CONFIG_PATH <<< "$(setup_ssh_dirs "$RAW_KEY_DIR")"
KEY_PATH="$KEY_DIR/id_rsa_${KEY_NAME}"

# ===== 產生並複製金鑰 =====
generate_copy_key "$USER_HOST" "$KEY_PATH" "$PASSWORD"

# ===== 更新 SSH config =====
update_ssh_config "$CONFIG_PATH" "$KEY_NAME" "$USER_HOST" "$KEY_PATH"

# ===== 確保主 config include config.d/* =====
ensure_main_config

echo "✅ SSH 設定完成，可使用：ssh ${KEY_NAME}"