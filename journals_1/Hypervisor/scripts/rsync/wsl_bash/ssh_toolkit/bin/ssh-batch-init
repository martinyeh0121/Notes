#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
UTILS_PATH="$SCRIPT_DIR/../lib/ssh_utils.sh"
source "$UTILS_PATH"

HOSTS_FILE="$SCRIPT_DIR/../config/hosts.yaml"

# 檢查 hosts.yaml 是否存在
if [ ! -f "$HOSTS_FILE" ]; then
    echo "⚠️ 找不到設定檔：$HOSTS_FILE"
    exit 1
fi

# ===== 檢查並安裝 sshpass =====
check_install_sshpass || exit 1

# 讀取設定
RAW_KEY_DIR=$(yq -r '.config.key_dir' "$HOSTS_FILE")
DO_SETUP_REMOTE=$(yq -r '.config.steps.setup_remote // false' "$HOSTS_FILE")

# 顯示執行步驟
echo "執行步驟設定:"
echo "- 設定遠端主機: ${DO_SETUP_REMOTE}"
echo

# ===== 設定目錄與檔案 =====
IFS=':' read -r KEY_DIR CONFIG_PATH <<< "$(setup_ssh_dirs "$RAW_KEY_DIR")"

# 逐台主機處理
for KEY_NAME in $(yq -r '.hosts[]' "$HOSTS_FILE"); do
    # 讀取主機資訊
    USER=$(yq -r ".hosts_map.${KEY_NAME}.user" "$HOSTS_FILE")
    HOST=$(yq -r ".hosts_map.${KEY_NAME}.host" "$HOSTS_FILE")
    PASSWORD=$(yq -r ".hosts_map.${KEY_NAME}.password // \"\"" "$HOSTS_FILE")
    USER_HOST="${USER}@${HOST}"

    echo "=== 設定 $USER_HOST ($KEY_NAME) ==="
    KEY_PATH="$KEY_DIR/id_rsa_${KEY_NAME}"

    # ===== 產生並複製金鑰 =====
    generate_copy_key "$USER_HOST" "$KEY_PATH" "$PASSWORD"

    # ===== 更新 SSH config =====
    update_ssh_config "$CONFIG_PATH" "$KEY_NAME" "$USER_HOST" "$KEY_PATH"

    # ===== 設定遠端主機 =====
    if [ "$DO_SETUP_REMOTE" = "true" ]; then
        NEW_HOSTNAME=$(yq -r ".hosts_map.${KEY_NAME}.setup.hostname // \"\"" "$HOSTS_FILE")
        NEW_PASSWORD=$(yq -r ".hosts_map.${KEY_NAME}.setup.new_password // \"\"" "$HOSTS_FILE")
        setup_remote_host "$USER_HOST" "$PASSWORD" "$NEW_HOSTNAME" "$NEW_PASSWORD" "$KEY_NAME"
    fi

    echo
done

# ===== 確保主 config include config.d/* =====
ensure_main_config

echo "✅ 批次 SSH 設定完成"